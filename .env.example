# Copy to backend/.env and frontend/.env.local as needed. No real credentials go here.

# --- Backend (backend/.env) ---
# Where uploaded files are stored. Must be outside the frontend's public/ folder.
UPLOAD_DIR=./data/uploads
# Max upload size in bytes (10 MB)
MAX_UPLOAD_BYTES=10485760
# JSON list of allowed browser origins
CORS_ORIGINS=["http://localhost:3000"]
# Agent explainer: only "mock" is implemented. No paid model APIs are called.
EXPLAINER_MODE=mock

# --- Frontend (frontend/.env.local) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Optional AWS (Phase 7, not used yet) ---
# Leave unset. Nothing in this project creates cloud resources without explicit approval.
# AWS_REGION=
# AWS_PROFILE=
